# Copy to .env.local (gitignored) and fill in locally. Never paste real values into chat or commits.

# The Odds API key: https://the-odds-api.com (Starter plan is free, 500 credits/month)
ODDS_API_KEY=

# Optional override; defaults to https://api.the-odds-api.com
# ODDS_API_BASE_URL=

# PostgreSQL connection string (used from Phase 1 onward)
DATABASE_URL=

# Cost controls (credits). An /odds call for h2h,spreads,totals across <=10 named books costs 3.
MONTHLY_CREDIT_BUDGET=400
MAX_CREDITS_PER_RUN=3
MIN_CREDITS_REMAINING=25

# Per-request HTTP timeout
HTTP_TIMEOUT_MS=15000
