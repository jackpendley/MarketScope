{
  "name": "@marketscope/collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "collect:nfl": "node --env-file-if-exists=.env.local --import tsx src/scripts/collect-nfl.ts",
    "signals:compute": "node --env-file-if-exists=.env.local --import tsx src/scripts/compute-signals.ts",
    "import:oddspapi": "node --env-file-if-exists=.env.local --import tsx src/scripts/import-oddspapi.ts",
    "import:line-moves": "node --max-old-space-size=6144 --env-file-if-exists=.env.local --import tsx src/scripts/import-line-moves.ts",
    "verify:provider": "node --env-file-if-exists=.env.local --import tsx src/scripts/verify-provider.ts",
    "probe:books": "node --env-file-if-exists=.env.local --import tsx src/scripts/probe-books.ts",
    "seed:synthetic": "node --import tsx src/scripts/seed-synthetic.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marketscope/db": "workspace:*",
    "@marketscope/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
