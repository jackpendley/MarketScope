          "value": "(\"odds_observations\".\"market_type\" IN ('h2h', 'spreads') AND \"odds_observations\".\"selection\" IN ('HOME', 'AWAY'))\n        OR (\"odds_observations\".\"market_type\" = 'totals' AND \"odds_observations\".\"selection\" IN ('OVER', 'UNDER'))"
        },
