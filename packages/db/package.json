{
  "name": "@marketscope/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/scripts/migrate.ts",
    "explain": "node --env-file-if-exists=.env.local --import tsx src/scripts/explain.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
